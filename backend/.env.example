# Copie para .env e preencha. O .env NUNCA vai para o Git (já está no .gitignore).

# Postgres. Local via Docker, ou a URL do Render/Neon em produção.
DATABASE_URL=postgres://postgres:devlocal@localhost:5433/docesabor

# Segredo das sessões. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-48-bytes-aleatorios-nunca-use-este-valor

# Primeiro administrador, criado automaticamente na primeira subida.
ADMIN_EMAIL=dona@docesabor.com.br
ADMIN_SENHA=troque-por-uma-senha-forte

# Quem pode chamar a API. Separe por vírgula. Nunca use *.
ORIGENS_PERMITIDAS=http://localhost:8000,https://docesaborbr.github.io
